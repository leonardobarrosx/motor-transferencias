# Backend (Spring Boot). Para o Supabase use o pooler em modo session (porta 5432):
# jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/motor
DATABASE_USERNAME=motor
DATABASE_PASSWORD=motor
DATABASE_POOL_SIZE=10
CORS_ALLOWED_ORIGINS=http://localhost:5173
# "demo" carrega as contas de demonstração; deixe vazio num banco com dados reais
SPRING_PROFILES_ACTIVE=demo
PORT=8080
